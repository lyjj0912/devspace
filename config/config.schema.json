{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devspace.local/config/config.schema.json",
  "title": "DevSpace Universal Broker PERSONAL_DIRECT_OWNER Configuration",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "productProfile": {
      "type": "string",
      "const": "PERSONAL_DIRECT_OWNER"
    },
    "profile": {
      "type": "string",
      "enum": [
        "development",
        "production"
      ]
    },
    "deploymentMode": {
      "type": "string",
      "enum": [
        "parallel",
        "production"
      ]
    },
    "server": {
      "type": "object",
      "properties": {
        "publicBaseUrl": {
          "type": "string",
          "format": "uri"
        },
        "mcpPath": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^\\/.*"
        },
        "dataPlane": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "managementPlane": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "unixSocket": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "additionalProperties": false
        },
        "stagingPlane": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "canonicalConnectorName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
        },
        "allowedHosts": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "additionalProperties": false
    },
    "oauth": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "resource": {
          "type": "string",
          "format": "uri"
        },
        "principalMode": {
          "type": "string",
          "const": "single-owner"
        },
        "ownerInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capabilityScopes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "allowOfflineAccess": {
          "type": "boolean"
        },
        "legacyBlanketScopeCompatibility": {
          "type": "boolean",
          "const": false
        },
        "adminScopeEnabled": {
          "type": "boolean",
          "const": false
        },
        "allowAnonymousSessionFallback": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "supervisor": {
      "type": "object",
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "pattern": "^unix:\\/\\/.*"
            },
            {
              "type": "string",
              "const": "internal://pm2"
            }
          ]
        },
        "processManager": {
          "type": "string",
          "const": "pm2"
        },
        "processName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedScript": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "transactionDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "healthTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "responseFlushRequired": {
          "type": "boolean",
          "const": true
        },
        "restartPolicy": {
          "type": "object",
          "properties": {
            "maximumAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maximumDelayMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pagination": {
      "type": "object",
      "properties": {
        "cursorTtlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maximumSnapshotsPerPrincipal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "signingKeyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "previousSigningKeyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "signingKeyRef"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "catalogPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "objectRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "defaultTtlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maximumArtifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "maximumTotalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        }
      },
      "required": [
        "catalogPath",
        "objectRoot"
      ],
      "additionalProperties": false
    },
    "connector": {
      "type": "object",
      "properties": {
        "canonicalName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
        },
        "installationEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "drainGraceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "canonicalName"
      ],
      "additionalProperties": false
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "internal"
        },
        "preAuth": {
          "type": "object",
          "properties": {
            "refillPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "burst": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "refillPerMinute",
            "burst"
          ],
          "additionalProperties": false
        },
        "postAuth": {
          "type": "object",
          "properties": {
            "refillPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "burst": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "refillPerMinute",
            "burst"
          ],
          "additionalProperties": false
        },
        "initialize": {
          "type": "object",
          "properties": {
            "refillPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "burst": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "refillPerMinute",
            "burst"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mode",
        "preAuth",
        "postAuth",
        "initialize"
      ],
      "additionalProperties": false
    },
    "management": {
      "type": "object",
      "properties": {
        "bind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "publicExposure": {
          "type": "string",
          "const": "deny"
        },
        "authorizationKeyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "bind",
        "port",
        "publicExposure"
      ],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "sink": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "flushIntervalMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "rawArguments": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "sink"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "stateDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "oauthStateDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "artifactRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "processOutputRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sshControlDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "contextStore": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "contextWorktreeRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "envProfileConfig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "targetConfig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mcpRouteConfig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "stateFileMode": {
          "type": "string",
          "const": "0600"
        },
        "directoryMode": {
          "type": "string",
          "const": "0700"
        }
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "maximumRunningTotal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maximumRunningPerTarget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "terminalRetentionTtlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "maximumRetainedTerminalRecords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maximumOutputBytesPerProcess": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "terminalOverflowPolicy": {
          "type": "string",
          "const": "prune-oldest"
        },
        "internalRunnerMaximumConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "quotas": {
      "type": "object",
      "properties": {
        "contexts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "mcpConnections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "mcpRetainedResultBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "guiSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "artifacts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "inlineOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "artifactMaxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        }
      },
      "additionalProperties": false
    },
    "ttls": {
      "type": "object",
      "properties": {
        "contextSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "completedProcessSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "mcpIdleSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "mcpRetainedResultSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "guiSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "artifactSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "cursorSnapshotSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "aliases": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,63}$"
            }
          },
          "aliasOf": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "endpointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "transport": {
            "type": "string",
            "enum": [
              "local",
              "ssh"
            ]
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "user": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "platform": {
            "type": "string",
            "enum": [
              "macos",
              "linux",
              "windows",
              "unknown"
            ]
          },
          "defaultCwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "elevationPolicy": {
            "type": "string",
            "enum": [
              "deny",
              "prompt"
            ]
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "fs": {
                "type": "boolean"
              },
              "exec": {
                "type": "boolean"
              },
              "pty": {
                "type": "boolean"
              },
              "mcp": {
                "type": "boolean"
              },
              "artifact": {
                "type": "boolean"
              },
              "gui": {
                "type": "boolean"
              },
              "durableProcess": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "targetId",
          "displayName",
          "transport",
          "platform",
          "elevationPolicy"
        ],
        "additionalProperties": false
      }
    },
    "mcpRoutes": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "routeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "aliases": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,63}$"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "targetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "transport": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "local-stdio",
                  "ssh-stdio",
                  "streamable-http"
                ]
              },
              "targetId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "args": {
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "riskPolicy": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "const": "broker-owned"
              },
              "policyFile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "mode",
              "policyFile"
            ],
            "additionalProperties": false
          },
          "idleTtlSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "connectTimeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          },
          "invokeTimeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          }
        },
        "required": [
          "routeId",
          "displayName",
          "transport"
        ],
        "additionalProperties": false
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "publicHealth": {
          "type": "boolean"
        },
        "publicMetrics": {
          "type": "boolean",
          "const": false
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "silent",
            "error",
            "warn",
            "info",
            "debug"
          ]
        },
        "redactSecrets": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "expectedToolNames": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "expectedTargetIdsFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requireCleanSource": {
          "type": "boolean"
        },
        "requireRuntimeBuildDigestMatch": {
          "type": "boolean"
        },
        "requireHostSessionChurnCanary": {
          "type": "boolean"
        },
        "forbidParallelRuntime": {
          "type": "boolean"
        },
        "forbidLegacyScopes": {
          "type": "boolean"
        },
        "forbidPrivilegedArtifacts": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "productProfile"
  ],
  "additionalProperties": false
}
