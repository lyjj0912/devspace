{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devspace.local/contracts/tools-v2.schema.json",
  "title": "DevSpace Universal Broker v2 Tool Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tools", "budgets"],
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "context",
        "fs",
        "exec",
        "process",
        "mcp",
        "artifact",
        "gui"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/targetTool"
        },
        "context": {
          "$ref": "#/$defs/contextTool"
        },
        "fs": {
          "$ref": "#/$defs/fsTool"
        },
        "exec": {
          "$ref": "#/$defs/execTool"
        },
        "process": {
          "$ref": "#/$defs/processTool"
        },
        "mcp": {
          "$ref": "#/$defs/mcpTool"
        },
        "artifact": {
          "$ref": "#/$defs/artifactTool"
        },
        "gui": {
          "$ref": "#/$defs/guiTool"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumTools",
        "maximumToolDescriptorCharacters",
        "maximumServerInstructionCharacters",
        "maximumInitialContextCharacters",
        "maximumReusedContextCharacters",
        "maximumMetaCharacters"
      ],
      "properties": {
        "maximumTools": { "const": 8 },
        "maximumToolDescriptorCharacters": { "const": 12000 },
        "maximumServerInstructionCharacters": { "const": 2000 },
        "maximumInitialContextCharacters": { "const": 4000 },
        "maximumReusedContextCharacters": { "const": 800 },
        "maximumMetaCharacters": { "const": 8000 }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "targetTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "operations": {
              "const": ["list", "resolve", "probe"]
            }
          }
        }
      ]
    },
    "contextTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "operations": {
              "const": ["open", "search", "diff", "close"]
            }
          }
        }
      ]
    },
    "fsTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "operations": {
              "const": [
                "stat",
                "list",
                "read",
                "search",
                "write",
                "patch",
                "mkdir",
                "copy",
                "move",
                "remove",
                "hash",
                "sync"
              ]
            }
          }
        }
      ]
    },
    "execTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "operations": {
              "const": ["run"]
            }
          }
        }
      ]
    },
    "processTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "operations": {
              "const": ["poll", "write", "resize", "signal", "wait", "list", "forget"]
            }
          }
        }
      ]
    },
    "mcpTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "operations": {
              "const": [
                "routes",
                "search_tools",
                "describe_tool",
                "invoke",
                "list_resources",
                "read_resource",
                "list_prompts",
                "get_prompt",
                "close"
              ]
            }
          }
        }
      ]
    },
    "artifactTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "operations": {
              "const": ["receive", "publish", "copy"]
            }
          }
        }
      ]
    },
    "guiTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "operations": {
              "const": ["capabilities", "observe", "act", "wait"]
            }
          }
        }
      ]
    }
  }
}
