                    "minLength": 1
                  },
                  "content": {
                    "type": "string"
                  },
                  "patch": {
                    "type": "string"
                  },
                  "query": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recursive": {
                    "type": "boolean"
                  },
                  "overwrite": {
                    "type": "boolean"
                  },
                  "expectedSha256": {
                    "type": "string",
                    "minLength": 1
                  },
                  "disposition": {
                    "type": "string",
                    "enum": [
                      "trash",
                      "permanent"
                    ]
                  },
                  "sync": {
                    "type": "object",
                    "properties": {
                      "phase": {
                        "type": "string",
                        "enum": [
                          "plan",
                          "apply"
                        ]
                      },
                      "planId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "planDigest": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "include": {
                        "maxItems": 1024,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        }
                      },
                      "exclude": {
                        "maxItems": 1024,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        }
                      },
                      "deleteMode": {
                        "type": "string",
                        "enum": [
                          "none",
                          "trash",
                          "permanent"
                        ]
                      },
                      "conflictStrategy": {
                        "type": "string",
                        "enum": [
                          "fail",
                          "source-wins"
                        ]
                      }
                    },
                    "required": [
                      "phase"
                    ],
                    "additionalProperties": false
                  },
                  "finalSymlink": {
                    "type": "string",
                    "enum": [
                      "follow",
                      "preserve",
                      "replace",
                      "reject"
                    ]
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cursor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                },
                "required": [
                  "operation"
                ]
              }
            },
            "outputSchema": {
              "$ref": "#/$defs/resultOutputSchemaConstant"
            },
            "annotations": {
              "const": {
                "readOnlyHint": false,
                "destructiveHint": true,
                "idempotentHint": false,
                "openWorldHint": true
              }
            }
          }
        }
      ]
    },
