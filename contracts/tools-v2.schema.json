{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devspace.local/contracts/tools-v2.schema.json",
  "title": "DevSpace Universal Broker v2 Tool Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requestMetaSchema",
    "resultOutputSchema",
    "tools",
    "budgets"
  ],
  "properties": {
    "version": {
      "const": "2.1.1"
    },
    "requestMetaSchema": {
      "$ref": "#/$defs/requestMetaSchemaConstant"
    },
    "resultOutputSchema": {
      "$ref": "#/$defs/resultOutputSchemaConstant"
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "context",
        "fs",
        "exec",
        "process",
        "mcp",
        "artifact",
        "gui"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/targetTool"
        },
        "context": {
          "$ref": "#/$defs/contextTool"
        },
        "fs": {
          "$ref": "#/$defs/fsTool"
        },
        "exec": {
          "$ref": "#/$defs/execTool"
        },
        "process": {
          "$ref": "#/$defs/processTool"
        },
        "mcp": {
          "$ref": "#/$defs/mcpTool"
        },
        "artifact": {
          "$ref": "#/$defs/artifactTool"
        },
        "gui": {
          "$ref": "#/$defs/guiTool"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumTools",
        "maximumToolDescriptorCharacters",
        "maximumServerInstructionCharacters",
        "maximumInitialContextCharacters",
        "maximumReusedContextCharacters",
        "maximumMetaCharacters"
      ],
      "properties": {
        "maximumTools": {
          "const": 8
        },
        "maximumToolDescriptorCharacters": {
          "const": 9000
        },
        "maximumServerInstructionCharacters": {
          "const": 2000
        },
        "maximumInitialContextCharacters": {
          "const": 4000
        },
        "maximumReusedContextCharacters": {
          "const": 512
        },
        "maximumMetaCharacters": {
          "const": 8000
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "inputSchema",
        "outputSchema",
        "annotations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "requestMetaSchemaConstant": {
      "const": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "transactionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedSchemaGeneration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expectedTargetGeneration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expectedRouteGeneration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "additionalProperties": false
      }
    },
    "resultOutputSchemaConstant": {
      "const": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "operationId": {
            "type": "string"
          },
          "data": {},
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "resourceUri": {
            "type": "string"
          },
          "nextCursor": {
            "type": "string"
          },
          "observedSchemaGeneration": {
            "type": "string"
          },
          "observedTargetGeneration": {
            "type": "string"
          },
          "observedRouteGeneration": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "AUTHENTICATION_FAILED",
                  "SCOPE_INSUFFICIENT",
                  "CAPABILITY_UNAVAILABLE",
                  "TARGET_NOT_FOUND",
                  "TARGET_AMBIGUOUS",
                  "TARGET_OFFLINE",
                  "PATH_NOT_FOUND",
                  "PATH_TYPE_MISMATCH",
                  "PERMISSION_DENIED",
                  "PRECONDITION_FAILED",
                  "TRANSPORT_UNAVAILABLE",
                  "TRANSPORT_INTERRUPTED",
                  "EXECUTION_STATE_UNKNOWN",
                  "PROCESS_NOT_FOUND",
                  "MCP_ROUTE_NOT_FOUND",
                  "MCP_TOOL_NOT_FOUND",
                  "MCP_PROVIDER_ERROR",
                  "MCP_CONNECTION_UNAVAILABLE",
                  "MCP_RESULT_UNKNOWN",
                  "DISPATCH_STATE_UNKNOWN",
                  "HOST_ACTION_BLOCKED",
                  "HOST_CAPABILITY_UNAVAILABLE",
                  "HOST_ARTIFACT_CAPABILITY_UNAVAILABLE",
                  "GUI_STATE_CHANGED",
                  "OUTPUT_TRUNCATED",
                  "RESOURCE_QUOTA_EXCEEDED",
                  "RESOURCE_BUSY",
                  "RATE_LIMITED",
                  "CURSOR_INVALID",
                  "CURSOR_EXPIRED",
                  "CURSOR_STALE",
                  "STATE_CORRUPTED",
                  "INVALID_ARGUMENT",
                  "RESOURCE_EXPIRED",
                  "TARGET_IDENTITY_MISMATCH",
                  "PROCESS_NOT_DURABLE",
                  "GUI_GENERATION_MISMATCH",
                  "SCHEMA_STALE",
                  "ELEVATION_BLOCKED",
                  "ELEVATION_DENIED",
                  "SYNC_PLAN_STALE",
                  "SYNC_CONFLICT",
                  "RESTART_ACK_NOT_FLUSHED",
                  "ARTIFACT_CATALOG_UNAVAILABLE",
                  "ARTIFACT_EXPIRED",
                  "PROFILE_UNSUPPORTED",
                  "MIGRATION_CONFLICT",
                  "ROLLBACK_STATE_UNKNOWN",
                  "CONNECTOR_STATE_CONFLICT",
                  "SUPERVISOR_UNAVAILABLE",
                  "FINALIZATION_STAGE_CONFLICT"
                ]
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "dispatchState": {
                "type": "string",
                "enum": [
                  "NOT_DISPATCHED",
                  "DISPATCHED",
                  "ACKNOWLEDGED",
                  "UNKNOWN"
                ]
              },
              "resourceKey": {
                "type": "string"
              },
              "evidence": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "recovery": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "suggestions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "dispatchState"
            ],
            "additionalProperties": false
          },
          "audit": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "ok",
          "operationId",
          "observedSchemaGeneration"
        ],
        "additionalProperties": false
      }
    },
    "targetTool": {
      "allOf": [
        {
          "$ref": "#/$defs/tool"
        },
        {
          "properties": {
            "operations": {
              "const": [
                "list",
                "resolve",
                "probe"
              ]
            },
            "inputSchema": {
              "const": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "list",
                      "resolve",
                      "probe"
                    ]
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targetId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "refresh": {
                    "type": "boolean"
                  },
                  "cursor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                },
                "required": [
                  "operation"
                ]
              }
            },
            "outputSchema": {
              "$ref": "#/$defs/resultOutputSchemaConstant"
            },
            "annotations": {
              "const": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": true
              }
            }
          }
        }
      ]
    },
    "contextTool": {
      "allOf": [
